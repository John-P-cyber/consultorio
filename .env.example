# Copie para .env (não o versione) e substitua os valores.
DATABASE_URL=postgresql+psycopg2://postgres:senha_forte@localhost:5432/consultorio
SECRET_KEY=gere_uma_chave_longa_aleatoria_com_pelo_menos_32_caracteres
MFA_MASTER_KEY=gere_outra_chave_aleatoria_diferente_com_32_caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
MFA_CHALLENGE_EXPIRE_MINUTES=5
MFA_LOCK_MINUTES=15
MFA_ISSUER=Clinica Saude
SESSION_MAX_ACTIVE=10
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
APP_ENV=development
SERVICE_NAME=consultorio-api
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
CLINIC_PROVISIONING_TOKEN=defina_um_token_longo_para_autorizar_novas_clinicas
TERMOS_VERSAO=2026-08-01
PRIVACIDADE_VERSAO=2026-08-01-v2
PRONTUARIO_RETENTION_YEARS=20
PRONTUARIO_UPLOAD_DIR=./uploads/prontuarios
PRONTUARIO_MAX_UPLOAD_MB=10
RESET_TOKEN_EXPIRE_MINUTES=15
RESET_URL=http://127.0.0.1:8000/recuperar-senha.html
# Para produção, configure um provedor SMTP:
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USERNAME=usuario
# SMTP_PASSWORD=senha
# SMTP_FROM=nao-responda@exemplo.com
