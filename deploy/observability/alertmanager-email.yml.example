global:
  smtp_smarthost: smtp.exemplo.com:587
  smtp_from: alertas@exemplo.com.br
  smtp_auth_username: alertas@exemplo.com.br
  smtp_auth_password: substitua
  smtp_require_tls: true

route:
  receiver: operacoes
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: operacoes
    email_configs:
      - to: operacoes@exemplo.com.br
        send_resolved: true
