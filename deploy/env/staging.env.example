APP_ENV=staging
SERVICE_NAME=consultorio-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://usuario_staging:senha@host-gerenciado:5432/consultorio_staging?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
SECRET_KEY=substitua_por_uma_chave_exclusiva_de_homologacao_com_64_caracteres
MFA_MASTER_KEY=substitua_por_outra_chave_exclusiva_de_homologacao
CLINIC_PROVISIONING_TOKEN=substitua_por_um_token_exclusivo_de_homologacao
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
ALLOWED_ORIGINS=https://staging.clinica.exemplo.com.br
RESET_URL=https://staging.clinica.exemplo.com.br/recuperar-senha.html
PRONTUARIO_UPLOAD_DIR=/app/uploads/prontuarios
PRONTUARIO_MAX_UPLOAD_MB=10
PRONTUARIO_RETENTION_YEARS=20
SMTP_HOST=smtp.sandbox.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=usuario_staging
SMTP_PASSWORD=substitua
SMTP_FROM=nao-responda-staging@exemplo.com.br
