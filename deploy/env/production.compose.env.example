COMPOSE_PROJECT_NAME=consultorio-production
DEPLOY_ENVIRONMENT=production
APP_DOMAIN=clinica.exemplo.com.br
APP_IMAGE=ghcr.io/organizacao/consultorio-api:sha-substitua
APP_ENV_FILE=/etc/consultorio/production.env
BACKUP_ENV_FILE=/etc/consultorio/backup-production.env
OBSERVABILITY_ENV_FILE=/etc/consultorio/observability.env
ALERTMANAGER_CONFIG_FILE=/etc/consultorio/alertmanager.yml
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSITE_ENABLED=true
RELEASE_SHA=substitua
APP_MEMORY_LIMIT=1g
APP_CPU_LIMIT=1.0
