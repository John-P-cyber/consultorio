COMPOSE_PROJECT_NAME=consultorio-staging
DEPLOY_ENVIRONMENT=staging
APP_DOMAIN=staging.clinica.exemplo.com.br
APP_IMAGE=ghcr.io/organizacao/consultorio-api:sha-substitua
APP_ENV_FILE=/etc/consultorio/staging.env
BACKUP_ENV_FILE=/etc/consultorio/backup-staging.env
OBSERVABILITY_ENV_FILE=/etc/consultorio/observability-staging.env
ALERTMANAGER_CONFIG_FILE=/etc/consultorio/alertmanager-staging.yml
BACKUP_RETENTION_DAYS=7
BACKUP_OFFSITE_ENABLED=true
RELEASE_SHA=substitua
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=0.75
