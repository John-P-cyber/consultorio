APP_ENV=production
SERVICE_NAME=consultorio-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://usuario:senha@host-gerenciado:5432/consultorio?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
SECRET_KEY=substitua_por_uma_chave_aleatoria_com_64_ou_mais_caracteres
MFA_MASTER_KEY=substitua_por_outra_chave_aleatoria_com_64_ou_mais_caracteres
CLINIC_PROVISIONING_TOKEN=substitua_por_um_token_aleatorio_e_protegido
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
ALLOWED_ORIGINS=https://clinica.exemplo.com.br
RESET_URL=https://clinica.exemplo.com.br/recuperar-senha.html
PRONTUARIO_UPLOAD_DIR=/app/uploads/prontuarios
PRONTUARIO_MAX_UPLOAD_MB=10
PRONTUARIO_RETENTION_YEARS=20
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=usuario
SMTP_PASSWORD=substitua
SMTP_FROM=nao-responda@exemplo.com.br
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
WHATSAPP_ACCESS_TOKEN=substitua_por_token_permanente_do_meta_business
WHATSAPP_API_VERSION=v23.0
COMMUNICATION_WORKER_ENABLED=true
COMMUNICATION_WORKER_INTERVAL_SECONDS=300
